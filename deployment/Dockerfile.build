# Build-only provider configuration is a BuildKit secret, never an image layer.
FROM node:22.23.4-bookworm-slim AS build
WORKDIR /app
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 HUSKY=0
RUN --mount=type=secret,id=website-build.json,required=true node deployment/build.mjs

FROM scratch AS artifacts
COPY --from=build /app/.next/standalone /standalone
COPY --from=build /app/.next/static /static
COPY --from=build /app/public /public
