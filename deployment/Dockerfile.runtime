# Build this only from the generated standalone/public/static release context.
FROM node:22.23.4-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1
COPY --chown=node:node standalone/ ./
COPY --chown=node:node public/ ./public/
COPY --chown=node:node static/ ./.next/static/
COPY --chown=node:node start-production.mjs ./start-production.mjs
USER node
EXPOSE 3000
CMD ["node", "start-production.mjs"]
